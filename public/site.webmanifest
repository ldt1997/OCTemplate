{
  "name": "OCTemplate",
  "short_name": "OCTemplate",
  "description": "在线图片模板生成器，支持上传图片、实时预览并导出固定尺寸 PNG。",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ff385c",
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "48x48 32x32 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/og/og_image.webp",
      "sizes": "1200x630",
      "type": "image/webp",
      "purpose": "any"
    }
  ]
}

